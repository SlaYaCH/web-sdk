<script lang="ts">
	import { SpineProvider, SpineTrack } from 'pixi-svelte';
	import { stateBetDerived } from 'state-shared';

	import { getContext } from '../game/context';
	import type { Reel } from '../game/stateGame.svelte';
	import { REEL_PADDING, SYMBOL_SIZE } from '../game/constants';
	import { boardBox, gridFracs } from '../game/boardBox';

	type Props = {
		reel: Reel;
		oncomplete: () => void;
	};

	const props: Props = $props();
	const context = getContext();

	// ============================================================
	// Le cadre de suspense se cale sur la GEOMETRIE REELLE de la grille,
	// pas sur une taille de symbole supposee. Il utilise exactement les
	// memes reperes que ceux qui placent les symboles, donc il tombe pile
	// sur sa colonne quelle que soit la resolution et le palier.
	//
	// REGLAGES : 1.0 = exactement la colonne / la hauteur de grille.
	// Montez un peu si le halo du spine a besoin de respirer.
	const ANTICIPATION_LARGEUR = 1.0;
	const ANTICIPATION_HAUTEUR = 1.0;

	const box = $derived(boardBox(context.stateGame.tier));
	const f = $derived(gridFracs(context.stateGame.tier));
	const largeurColonne = $derived(((f.right - f.left) / 5) * box.width);
	const hauteurGrille = $derived((f.bottom - f.top) * box.height);
	const centreGrilleY = $derived(box.y + box.height * ((f.top + f.bottom) / 2));
	const centreColonne = (reelIndex: number) =>
		box.x + box.width * f.left + largeurColonne * (reelIndex + 0.5);

	type AnimationName = 'anticipation_intro' | 'anticipation_loop' | 'anticipation_out';

	let animationName = $state<AnimationName>('anticipation_intro');

	$effect(() => {
		if (props.reel.reelState.motion === 'stopped') {
			animationName = 'anticipation_out';
		}
	});
</script>

<SpineProvider
	key="anticipation"
	width={largeurColonne * ANTICIPATION_LARGEUR}
	height={hauteurGrille * ANTICIPATION_HAUTEUR}
	x={centreColonne(props.reel.reelIndex)}
	y={centreGrilleY}
>
	<SpineTrack
		trackIndex={0}
		{animationName}
		loop={animationName === 'anticipation_loop'}
		timeScale={stateBetDerived.timeScale()}
		listener={{
			complete: () => {
				if (animationName === 'anticipation_intro') {
					animationName = 'anticipation_loop';
				}

				if (animationName === 'anticipation_out') {
					props.oncomplete();
				}
			},
		}}
	/>
</SpineProvider>
